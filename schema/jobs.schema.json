{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/elora-grid/remote-electrical-engineering-jobs/schema/jobs.schema.json",
 "title": "Remote electrical engineering jobs (USA)",
 "type": "object",
 "required": [
  "snapshot",
  "count",
  "jobs"
 ],
 "properties": {
  "name": {
   "type": "string"
  },
  "source": {
   "type": "string",
   "format": "uri"
  },
  "snapshot": {
   "type": "string",
   "format": "date"
  },
  "license": {
   "type": "string"
  },
  "count": {
   "type": "integer"
  },
  "jobs": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "company",
     "title",
     "field",
     "role",
     "fullyRemote",
     "location",
     "listingUrl",
     "checked",
     "eloraUrl"
    ],
    "properties": {
     "id": {
      "type": "string",
      "description": "Stable id derived from the listing URL"
     },
     "company": {
      "type": "string"
     },
     "companyWebsite": {
      "type": [
       "string",
       "null"
      ],
      "format": "uri"
     },
     "title": {
      "type": "string"
     },
     "field": {
      "type": "string",
      "enum": [
       "Power systems & utilities",
       "Electronics & hardware",
       "Chips & semiconductors",
       "Controls & automation",
       "Buildings & data centers",
       "Renewables, storage & EV",
       "Other electrical"
      ]
     },
     "role": {
      "type": "string",
      "enum": [
       "Engineer",
       "EE-adjacent engineer",
       "Designer / drafter",
       "Manager / project lead",
       "Internship / co-op"
      ]
     },
     "fullyRemote": {
      "type": "boolean",
      "description": "No office days, no requirement to live near an office, travel under 50%"
     },
     "notFullyRemoteReason": {
      "type": [
       "string",
       "null"
      ]
     },
     "location": {
      "type": "string",
      "description": "Location exactly as listed"
     },
     "remoteEvidence": {
      "type": "string",
      "description": "Why the job counts as remote"
     },
     "salaryText": {
      "type": [
       "string",
       "null"
      ],
      "description": "Pay exactly as listed"
     },
     "salary": {
      "type": [
       "object",
       "null"
      ],
      "properties": {
       "min": {
        "type": "number"
       },
       "max": {
        "type": "number"
       },
       "period": {
        "enum": [
         "year",
         "hour"
        ]
       },
       "annualMin": {
        "type": "number"
       },
       "annualMax": {
        "type": "number"
       },
       "annualMid": {
        "type": "number"
       }
      }
     },
     "statesAllowed": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[A-Z]{2}$"
      }
     },
     "statesExcluded": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[A-Z]{2}$"
      }
     },
     "requirements": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "label": {
         "type": "string"
        },
        "text": {
         "type": "string"
        }
       }
      }
     },
     "flags": {
      "type": "object",
      "properties": {
       "clearance": {
        "type": "boolean"
       },
       "citizen": {
        "type": "boolean"
       },
       "noSponsor": {
        "type": "boolean"
       },
       "pe": {
        "enum": [
         "required",
         "preferred"
        ]
       },
       "travel": {
        "type": "integer",
        "description": "Maximum travel %, or -1 when travel is mentioned without a figure"
       },
       "locationNote": {
        "type": "boolean"
       }
      }
     },
     "skills": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "listingUrl": {
      "type": "string",
      "format": "uri",
      "description": "The posting on the employer's own site"
     },
     "listingPlatform": {
      "type": "string"
     },
     "posted": {
      "type": [
       "string",
       "null"
      ],
      "format": "date"
     },
     "checked": {
      "type": "string",
      "format": "date"
     },
     "eloraUrl": {
      "type": "string",
      "format": "uri"
     }
    }
   }
  }
 }
}